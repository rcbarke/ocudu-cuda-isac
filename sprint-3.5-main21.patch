+    def test_the_filter_holds_a_position_and_follows_a_walk(self):
+        grid = grid_of(50, 34)
+        settings = cusense.demo_settings()["smoothing"]
+        still = cusense.Smoother(settings, grid, 0.005)
+
+        def one_hot(cell):
+            drawn = np.zeros((50, 34))
+            drawn[cell] = 1.0
+            return drawn
+
+        for period in range(20):
