+# float32 value. The probability and the cells of the map are bounded and take an absolute tolerance.
+TOLERANCE = {"logit_absolute": 1e-3, "logit_relative": 1e-4, "probability_absolute": 2.5e-4, "map_absolute": 1e-4,
