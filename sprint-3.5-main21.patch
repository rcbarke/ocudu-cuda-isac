+    @classmethod
+    def release(cls):
+        """Clean up every stage under this one: each holds what the stage below it made."""
+        stage = cls.stage
+        while stage is not None:
+            stage.doClassCleanups()
+            stage.tearDownClass()
+            stage = getattr(stage, "stage", None)
