+        "artifact_sha256": {arm: artifacts[arm].sha256 for arm in artifacts},
+        "threshold_logit": {arm: artifacts[arm].threshold for arm in artifacts},
+        "graded_quality": {"validation_auc_min": config["expect"]["validation_auc_min"],
